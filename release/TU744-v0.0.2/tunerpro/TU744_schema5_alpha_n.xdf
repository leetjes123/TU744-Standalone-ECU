  <XDFFLAG uniqueid="0x4002" flags="0x0">
    <title>Use target AFR in fuel calculation</title>
    <description>On: fuel is scaled by stoichiometric AFR / target AFR. Off: target AFR only feeds closed loop. Offset 0x8D0. Bit mask 0x01.</description>
    <CATEGORYMEM index="0" category="1" />
    <EMBEDDEDDATA mmedtypeflags="0x00" mmedaddress="0x8d0" mmedelementsizebits="8" mmedrowcount="1" mmedcolcount="1" mmedmajorstridebits="0" mmedminorstridebits="0" />
