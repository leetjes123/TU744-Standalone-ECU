    <CATEGORYMEM index="0" category="20" />
    <CATEGORYMEM index="1" category="11" />
    <EMBEDDEDDATA mmedtypeflags="0x00" mmedaddress="0x7b2" mmedelementsizebits="16" mmedrowcount="1" mmedcolcount="1" mmedmajorstridebits="0" mmedminorstridebits="0" />
